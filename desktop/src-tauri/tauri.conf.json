{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dahlia",
  "version": "0.1.0",
  "identifier": "org.dahlialinux.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app", "deb", "appimage"],
    "category": "Utility",
    "shortDescription": "Dahlia Linux",
    "longDescription": "Desktop app for Dahlia Linux servers: dashboard and apps in native windows.",
    "license": "GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
