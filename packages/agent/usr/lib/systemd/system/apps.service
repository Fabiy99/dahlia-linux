[Unit]
Description=Dahlia apps: start enabled apps once the disks are mounted
Requires=docker.service
After=docker.service storage.target network-online.target srv.mount
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/apps start-enabled
ExecStop=/usr/sbin/apps stop-all
TimeoutStartSec=15min

[Install]
WantedBy=multi-user.target
