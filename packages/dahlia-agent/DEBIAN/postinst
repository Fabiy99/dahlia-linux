#!/bin/bash
# dahlia-agent postinst
set -euo pipefail

case "$1" in
    configure)
        if ! getent group dahlia-agent >/dev/null; then
            groupadd --system dahlia-agent
        fi
        # Containers get this user's UID/GID through {PUID}/{PGID}.
        if ! getent passwd dahlia-apps >/dev/null; then
            adduser --system --group --no-create-home --home /nonexistent \
                --shell /usr/sbin/nologin dahlia-apps
        fi
        # avahi-publish fails over D-Bus as a systemd DynamicUser
        # ("Failed to create client object"), so dahlia-mdns gets a fixed one.
        if ! getent passwd dahlia-mdns >/dev/null; then
            adduser --system --group --no-create-home --home /nonexistent \
                --shell /usr/sbin/nologin dahlia-mdns
        fi
        # SMB users managed by the dashboard (see dahlia_agent/smb.py).
        if ! getent group dahlia-smb >/dev/null; then
            groupadd --system dahlia-smb
        fi
        mkdir -p /var/lib/dahlia/apps
        # App data on the system SSD: /srv, on Btrfs its own subvolume @srv.
        /usr/lib/dahlia/system-data.sh || echo "dahlia-agent: /srv setup failed" >&2
        chmod 0755 /var/lib/dahlia
        chmod 0700 /var/lib/dahlia/apps
        systemctl enable dahlia-firewall.service >/dev/null 2>&1 || true
        # Weekly short SMART self-test: on once for new and upgraded systems,
        # after that the schedule in the dashboard decides (settings.set_schedule).
        if [ ! -e /var/lib/dahlia/smart-timers-set ]; then
            systemctl enable dahlia-smart-short.timer >/dev/null 2>&1 || true
            mkdir -p /var/lib/dahlia
            touch /var/lib/dahlia/smart-timers-set
        fi
        systemctl enable dahlia-agent.socket dahlia-apps.service dahlia-mdns.service \
            dahlia-domains.timer dahlia-apps-catalog.timer dahlia-spindown.service dahlia-notify.timer >/dev/null 2>&1 || true
        # Local CA, server certificate, app proxies. nginx may not be
        # configured yet; dahlia-dashboard runs this again.
        dahlia-domains apply >/dev/null || echo "dahlia-agent: dahlia-domains apply failed" >&2
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload
            # Firewall: only local networks, only ports in use (dahlia_agent/firewall.py).
            systemctl restart dahlia-firewall.service || echo "dahlia-agent: firewall not loaded" >&2
            sysctl -q -p /usr/lib/sysctl.d/50-dahlia-apps.conf || true
            # A running agent keeps the old code until restarted.
            systemctl try-restart dahlia-agent.service || true
            systemctl start dahlia-agent.socket dahlia-domains.timer dahlia-apps-catalog.timer dahlia-notify.timer || true
            if systemctl is-enabled --quiet dahlia-smart-short.timer; then
                systemctl start dahlia-smart-short.timer || true
            fi
            systemctl restart dahlia-mdns.service || true
            # Samba stays off until the first share is created in the dashboard.
            if [ ! -e /etc/dahlia/shares.json ]; then
                systemctl disable --now smbd.service nmbd.service >/dev/null 2>&1 || true
            fi
            # NUT stays off until a UPS is set up in the dashboard.
            if [ ! -e /etc/dahlia/ups.json ]; then
                systemctl disable --now nut-monitor.service nut-server.service \
                    nut-driver.target >/dev/null 2>&1 || true
            fi
            # daemon.json (ports on 127.0.0.1 only) applies after a restart.
            # Only while no app is installed: a restart stops containers.
            if [ -z "$(ls -A /var/lib/dahlia/apps)" ]; then
                systemctl try-restart docker.service || true
            fi
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
