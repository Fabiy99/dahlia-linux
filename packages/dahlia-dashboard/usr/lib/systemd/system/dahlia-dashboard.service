[Unit]
Description=Dahlia dashboard backend
After=network.target dahlia-agent.socket
Wants=dahlia-agent.socket
# The setup code must exist before tty1 prints its banner.
Before=getty@tty1.service

[Service]
User=dahlia-ui
Group=dahlia-ui
StateDirectory=dahlia-dashboard
StateDirectoryMode=0700
RuntimeDirectory=dahlia-dashboard
RuntimeDirectoryMode=0700
ExecStartPre=/usr/sbin/dahlia-dashboard --prepare
ExecStart=/usr/sbin/dahlia-dashboard
Restart=on-failure

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
