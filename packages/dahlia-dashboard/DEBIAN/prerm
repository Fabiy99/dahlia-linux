#!/bin/bash
# dahlia-dashboard prerm
set -euo pipefail

case "$1" in
    remove)
        if [ -d /run/systemd/system ]; then
            systemctl stop dahlia-dashboard.service || true
        fi
        systemctl disable dahlia-dashboard.service >/dev/null 2>&1 || true
        rm -f /etc/nginx/sites-enabled/dahlia
        if [ -d /run/systemd/system ]; then
            systemctl reload nginx.service 2>/dev/null || true
        fi
        ;;
    upgrade|deconfigure|failed-upgrade)
        ;;
    *)
        echo "prerm called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
