# Dahlia dashboard. Static files from nginx, /api/ to the backend on 127.0.0.1:8080.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;

    ssl_certificate     /etc/dahlia/tls/dashboard.crt;
    ssl_certificate_key /etc/dahlia/tls/dashboard.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /usr/share/dahlia-dashboard/www;
    index index.html;
    server_tokens off;
    client_max_body_size 64k;

    add_header Content-Security-Policy "default-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        # updates.check runs apt-get update.
        proxy_read_timeout 900s;
        add_header Cache-Control no-store always;
        add_header Content-Security-Policy "default-src 'none'" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
