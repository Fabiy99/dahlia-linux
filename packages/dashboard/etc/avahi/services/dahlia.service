<?xml version="1.0" standalone="no"?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- Lets the Dahlia desktop app find this server (mDNS service _dahlia._tcp). -->
<service-group>
  <name replace-wildcards="yes">%h</name>
  <service>
    <type>_dahlia._tcp</type>
    <port>443</port>
  </service>
</service-group>
