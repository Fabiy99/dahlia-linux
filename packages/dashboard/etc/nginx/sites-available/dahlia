# Dahlia dashboard. Static files from nginx, /api/ to the backend on 127.0.0.1:8080.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;

    # Signed by the local Dahlia CA, see domains.
    ssl_certificate     /etc/dahlia/tls/server.crt;
    ssl_certificate_key /etc/dahlia/tls/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /usr/share/dashboard/www;
    index index.html;
    server_tokens off;
    client_max_body_size 64k;

    add_header Content-Security-Policy "default-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # Terminal page: WebSocket to the backend, which relays to terminal.
    location = /api/terminal {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        # terminal closes idle sessions after 15 minutes.
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # File manager: uploads of any size go straight through to the backend,
    # downloads are not buffered on disk by nginx.
    location = /api/files/upload {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        client_max_body_size 0;
        proxy_request_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        add_header Cache-Control no-store always;
        add_header Content-Security-Policy "default-src 'none'" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location = /api/files/download {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        add_header Cache-Control no-store always;
        add_header Content-Security-Policy "default-src 'none'" always;
        add_header X-Content-Type-Options nosniff always;
    }

    # Only for the local screen, see the server on 127.0.0.1:8090 below.
    location = /api/screen {
        return 404;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        # updates.check runs apt-get update.
        proxy_read_timeout 900s;
        add_header Cache-Control no-store always;
        add_header Content-Security-Policy "default-src 'none'" always;
        add_header X-Content-Type-Options nosniff always;
    }

    # The CA certificate (public part only) for import into browsers.
    location = /dahlia-ca.crt {
        alias /etc/dahlia/tls/ca.crt;
        default_type application/x-x509-ca-cert;
        add_header Content-Disposition 'attachment; filename="dahlia-ca.crt"' always;
        add_header X-Content-Type-Options nosniff always;
    }

    # App logos from the catalog (dahlia_agent/apps.py). The ?v= hash changes
    # with the file, so the browser may keep them. No scripts, even when an
    # SVG is opened on its own.
    location ^~ /app-icons/ {
        alias /var/lib/dahlia/apps-catalog/icons/;
        types { image/svg+xml svg; image/png png; }
        default_type application/octet-stream;
        expires 30d;
        add_header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
    }

    # Web app manifest for "add to home screen".
    location = /manifest.webmanifest {
        types { }
        default_type application/manifest+json;
    }

    # The browser must ask again after every update: revalidate with
    # Last-Modified/ETag instead of using a heuristic cache lifetime.
    # add_header here replaces the server-level headers, so repeat them.
    location / {
        try_files $uri $uri/ =404;
        add_header Cache-Control no-cache always;
        add_header Content-Security-Policy "default-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }
}

# Local screen (screen.service): the browser on the attached monitor. Loopback
# only, plain HTTP, static files plus /api/screen and nothing else.
server {
    listen 127.0.0.1:8090;
    root /usr/share/dashboard/www;
    server_tokens off;

    add_header Content-Security-Policy "default-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'" always;
    add_header X-Content-Type-Options nosniff always;

    location = /api/screen {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Cache-Control no-store always;
    }

    location /api/ {
        return 404;
    }

    location / {
        try_files $uri =404;
        add_header Cache-Control no-cache always;
        add_header Content-Security-Policy "default-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'" always;
        add_header X-Content-Type-Options nosniff always;
    }
}
