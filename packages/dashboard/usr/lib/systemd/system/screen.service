[Unit]
Description=Dahlia start screen on the attached monitor
Documentation=https://github.com/Fabiy99/dahlia-linux
After=systemd-user-sessions.service dashboard.service nginx.service getty@tty1.service
Wants=dashboard.service nginx.service
# Takes over tty1. The text console stays on tty2 (Ctrl+Alt+F2); after three
# failed starts in a minute (no usable graphics) tty1 gets its login back.
Conflicts=getty@tty1.service
OnFailure=getty@tty1.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
# Only with a graphics device (DRM); headless servers keep the plain console.
ExecCondition=/bin/sh -c 'ls /dev/dri/card* >/dev/null 2>&1'
User=screen
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
# Software rendering works on every GPU, also in VMs without acceleration.
Environment=WLR_RENDERER=pixman WLR_LIBINPUT_NO_DEVICES=1 LIBGL_ALWAYS_SOFTWARE=1
ExecStart=/usr/bin/cage -s -- /usr/bin/cog http://127.0.0.1:8090/screen.html
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
