#!/bin/bash
# base postinst
set -euo pipefail

DAHLIA_GID=1000

setup_group() {
    if getent group dahlia >/dev/null; then
        return 0
    fi
    if getent group "$DAHLIA_GID" >/dev/null; then
        # GID 1000 is taken (e.g. by a user created outside the Dahlia installer).
        # Fall back to a free GID instead of failing the install.
        echo "base: GID $DAHLIA_GID in use, creating group 'dahlia' with a free GID" >&2
        groupadd dahlia
    else
        groupadd --gid "$DAHLIA_GID" dahlia
    fi
}

setup_snapper() {
    # Only for a Btrfs root and only once. snapper's apt hook
    # (/etc/apt/apt.conf.d/80snapper) then snapshots around every apt run.
    if [ "$(findmnt -no FSTYPE /)" != "btrfs" ]; then
        echo "base: root is not Btrfs, skipping snapper setup" >&2
        return 0
    fi
    if [ -e /etc/snapper/configs/root ]; then
        return 0
    fi
    if ! snapper --no-dbus -c root create-config /; then
        echo "base: snapper create-config failed, rollback snapshots are disabled" >&2
        return 0
    fi
    # Keep the snapshot count bounded on small system SSDs.
    snapper --no-dbus -c root set-config \
        NUMBER_LIMIT=20 NUMBER_LIMIT_IMPORTANT=10 \
        TIMELINE_CREATE=no
}

setup_auto_upgrades() {
    # Security updates on by default. The file is Debian's standard switch;
    # the dashboard (updates.set_auto) rewrites it. An existing one is kept.
    local f=/etc/apt/apt.conf.d/20auto-upgrades
    [ -e "$f" ] && return 0
    cat > "$f" <<'EOF'
// Written by Dahlia (dashboard: Updates). Package lists stay fresh either way.
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
EOF
}

case "$1" in
    configure)
        setup_group
        setup_snapper
        setup_auto_upgrades
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
