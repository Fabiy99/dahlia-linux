#!/bin/bash
# dahlia-storage postinst
set -euo pipefail

case "$1" in
    configure)
        mkdir -p /etc/dahlia /mnt/external
        # Pull in all Dahlia disk and pool units at boot.
        systemctl enable dahlia-storage.target >/dev/null 2>&1 || true
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
